# OpenAI: set only the key. Azure AI Foundry: also set LLM_BASE_URL; model names = deployment names.
LLM_API_KEY=
# LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
CHAT_MODEL=gpt-5.4-mini
EMBED_MODEL=text-embedding-3-small

# Evaluation judge: Claude Opus through a local, logged-in Claude Code (`claude` CLI); no key here.
# CLAUDE_JUDGE_MODEL=opus
# Reasoning effort of the answer step (low | medium | high); latency follows it, see README "Speed"
# ANSWER_EFFORT=low
