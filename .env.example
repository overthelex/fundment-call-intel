# OpenAI: set only the key. Azure AI Foundry: also set LLM_BASE_URL; model names = deployment names.
LLM_API_KEY=
# LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
CHAT_MODEL=gpt-5.4-mini
JUDGE_MODEL=gpt-5.4
EMBED_MODEL=text-embedding-3-small

# Judge (eval only). With ANTHROPIC_API_KEY set, Claude Opus grades via the Anthropic API;
# without it, JUDGE_MODEL above. JUDGE_BACKEND forces one: openai | anthropic | claude-cli
# (claude-cli = a local, logged-in Claude Code, no key needed).
# ANTHROPIC_API_KEY=
# JUDGE_BACKEND=
# CLAUDE_JUDGE_MODEL=claude-opus-5-5
